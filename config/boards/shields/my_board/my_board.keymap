#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
    };

    behaviors {
        dyn_macro: behavior_dynamic_macro {
            compatible = "zmk,behavior-dynamic-macro";
            #binding-cells = <1>;
        };


        inc_dec_mac: behavior_sensor_rotate_mac {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&dyn_macro>, <&dyn_macro>;
        };

    };

    combos {
        compatible = "zmk,combos";
//        combo_out_tog {
//            timeout-ms = <100>; // 100毫秒内同时按下生效 (更加宽容)
//            key-positions = <9 10>; // 对应第10和第11个按键（两个编码器的按压开关）
//            bindings = <&out_ht 0 0>; // 绑定到我们定义的5秒长按行为
//        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &dyn_macro 0 &dyn_macro 1 &dyn_macro 2
                &kp N4       &kp N5       &kp N6
                &kp N7       &kp N8       &kp N9
                
                &dyn_macro 52   &dyn_macro 56
            >;
            
            sensor-bindings = <&inc_dec_mac 50 51 &inc_dec_mac 54 55>;
        };

        layer_1 {
            bindings = <
                &trans &trans &trans
                &trans &trans &trans
                &trans &trans &trans
                
                &dyn_macro 60 &dyn_macro 64
            >;
            sensor-bindings = <&inc_dec_mac 58 59 &inc_dec_mac 62 63>;
        };

        layer_2 {
            bindings = <
                &trans &trans &trans
                &trans &trans &trans
                &trans &trans &trans
                
                &dyn_macro 68 &dyn_macro 72
            >;
            sensor-bindings = <&inc_dec_mac 66 67 &inc_dec_mac 70 71>;
        };

        layer_3 {
            bindings = <
                &trans &trans &trans
                &trans &trans &trans
                &trans &trans &trans
                
                &dyn_macro 76 &dyn_macro 80
            >;
            sensor-bindings = <&inc_dec_mac 74 75 &inc_dec_mac 78 79>;
        };

        layer_4 {
            bindings = <
                &trans &trans &trans
                &trans &trans &trans
                &trans &trans &trans
                
                &dyn_macro 84 &dyn_macro 88
            >;
            sensor-bindings = <&inc_dec_mac 82 83 &inc_dec_mac 86 87>;
        };
    };
};
